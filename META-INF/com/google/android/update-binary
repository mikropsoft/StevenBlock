#!/sbin/sh

OUTFD=$2
ZIPFILE=$3

if [ -n "$OUTFD" ]; then
  ui_print() {
    echo -e "ui_print $1\nui_print" >&"$OUTFD"
  }
else
  ui_print() {
    echo "$1"
  }
fi

mount /data 2>/dev/null

if [ -d /data/adb/magisk ]; then
  MODPATH="/data/adb/modules/stevenblock"
elif [ -d /data/adb/ksu ]; then
  MODPATH="/data/adb/ksu/modules/stevenblock"
elif [ -d /data/adb/ap ]; then
  MODPATH="/data/adb/ap/modules/stevenblock"
else
  ui_print "❌ No supported root manager found"
  exit 1
fi

mkdir -p "$MODPATH"
unzip -o "$ZIPFILE" -d "$MODPATH" >/dev/null 2>&1

set_perm() {
  chown "$2:$3" "$1" 2>/dev/null
  chmod "$4" "$1" 2>/dev/null
  if [ -n "$5" ]; then
    chcon "$5" "$1" 2>/dev/null
  else
    chcon u:object_r:system_file:s0 "$1" 2>/dev/null
  fi
}

set_perm_recursive() {
  find "$1" -type d 2>/dev/null | while IFS= read -r dir; do
    set_perm "$dir" "$2" "$3" "$4" "$6"
  done
  find "$1" -type f -o -type l 2>/dev/null | while IFS= read -r file; do
    set_perm "$file" "$2" "$3" "$5" "$6"
  done
}

. "$MODPATH/customize.sh"

exit 0